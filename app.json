{
  "expo": {
    "name": "distrxct",
    "slug": "distrxct",
    "version": "1.0.0",
    "scheme": "distrxct",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.distrxct.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "distrxct uses your location to show nearby interesting spots.",
        "NSPhotoLibraryUsageDescription": "distrxct needs photo library access to upload location images.",
        "NSCameraUsageDescription": "distrxct needs camera access to capture location photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.distrxct.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow distrxct to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow distrxct to access your photos.",
          "cameraPermission": "Allow distrxct to use your camera."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
